page{background:#f5f7f8;color:#253d4b;font-size:28rpx;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
view,text,button,input,picker{box-sizing:border-box}
button{margin:0;font-size:28rpx;line-height:1.5;border-radius:18rpx;font-weight:600;padding:24rpx 28rpx;background:#eaf3f5;color:#17778b}
button::after{border:0}button[type=primary],.primary{background:#17778b;color:#fff}button[disabled]{background:#edf1f4;color:#94a3aa}
button.secondary{background:#fff;border:1rpx solid #d9e3e8;color:#17778b}button.danger{background:#fff0ed;color:#a64337}button.small{padding:14rpx 24rpx;font-size:25rpx}button.link{background:transparent;color:#17778b;padding:10rpx 0;font-size:26rpx;font-weight:500}
.page{padding:36rpx 32rpx 60rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;font-weight:600;color:#7293a0}.title{font-size:44rpx;font-weight:700;letter-spacing:-1rpx;line-height:1.35;margin:10rpx 0 16rpx}.subtitle,.muted{color:#748791;font-size:25rpx}.subtitle{margin-bottom:30rpx}
.section{margin-top:36rpx}.section-head,.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.section-title{font-size:32rpx;font-weight:650}.card{background:#fff;border-radius:24rpx;padding:30rpx;margin-bottom:22rpx;border:1rpx solid #e1e8eb}.card-title{font-size:31rpx;font-weight:650}.description{color:#748791;font-size:25rpx;margin-top:10rpx}.stack{display:flex;flex-direction:column;gap:18rpx}
.badge{display:inline-block;border-radius:9rpx;background:#e2f0f3;color:#17778b;font-size:22rpx;padding:5rpx 14rpx;white-space:nowrap}.badge.warn{background:#fff2dc;color:#9b6720}.badge.gray{background:#f0f2f4;color:#748791}
.error{background:#fff0ed;color:#a64337;padding:24rpx;border-radius:18rpx;font-size:26rpx;margin:20rpx 0;word-break:break-all}.notice{background:#eaf3f5;color:#17778b;padding:24rpx;border-radius:18rpx;font-size:26rpx;margin:20rpx 0;word-break:break-all}
.empty{text-align:center;padding:52rpx 30rpx;background:#fff;border-radius:24rpx;border:1rpx solid #e1e8eb}.empty-title{font-size:31rpx;font-weight:650;margin:18rpx 0 10rpx}.empty button{margin-top:28rpx}.empty-symbol{width:84rpx;height:84rpx;border-radius:25rpx;background:#eaf3f5;color:#17778b;font-size:40rpx;line-height:84rpx;margin:auto}
.field{margin-top:26rpx}.field-label{display:block;font-size:26rpx;font-weight:600;margin-bottom:14rpx}.input,.picker{background:#f6f9fa;border:1rpx solid #d7e2e8;border-radius:15rpx;min-height:90rpx;padding:22rpx;font-size:28rpx;color:#2b4957}.hint{font-size:23rpx;color:#7a8f9a;margin-top:10rpx}.divider{height:1rpx;background:#eaf0f3;margin:24rpx 0}
.detail-row{display:flex;gap:26rpx;padding:14rpx 0;font-size:26rpx;word-break:break-all}.detail-label{color:#7a8f9a;min-width:150rpx}.detail-value{flex:1;text-align:right}.footnote{color:#83949d;font-size:22rpx;line-height:1.8;margin:28rpx 8rpx}
.entry{display:flex;align-items:center;padding:26rpx 0;border-bottom:1rpx solid #eaf0f3;gap:22rpx}.entry:last-child{border:0}.entry-body{flex:1;min-width:0}.chevron{color:#94a3aa;font-size:36rpx;font-weight:300}.icon-box{width:72rpx;height:72rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;background:#eaf3f5;color:#17778b;font-size:34rpx;flex-shrink:0}.nav-icon{width:44rpx;height:44rpx}
.split{display:flex;gap:16rpx}.split>view,.split>button{flex:1}.loading{padding:28rpx;text-align:center;color:#7a8f9a}.tabs{display:flex;gap:12rpx;margin:26rpx 0;flex-wrap:wrap}.tab{font-size:25rpx;padding:12rpx 22rpx;border-radius:100rpx;background:#edf3f5;color:#637c88}.tab.active{background:#17778b;color:white}.mono{font-size:22rpx;color:#8a9da7;word-break:break-all}.step-label{font-size:22rpx;color:#7d96a4;letter-spacing:2rpx}.card.soft{background:#eaf3f5;border:0}.pill{border:1rpx solid #d9e3e8;border-radius:14rpx;padding:18rpx;background:white;color:#4c6876}.pill.active{border-color:#17778b;background:#e2f0f3;color:#17778b}
.service-label{display:flex;align-items:flex-start;gap:12rpx;padding:20rpx 0;border-bottom:1rpx solid #eaf0f3;font-size:27rpx}.service-label:last-child{border:0}checkbox{transform:scale(.82);transform-origin:left center}.check-label{display:flex;align-items:flex-start;font-size:25rpx;color:#4d6876;gap:8rpx}.spacer{height:24rpx}


.subtitle,.muted,.description,.hint,.detail-label,.footnote,.step-label{color:#566e7b}.mono{color:#566e7b}
