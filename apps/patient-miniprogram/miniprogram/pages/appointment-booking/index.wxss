.progress{display:flex;align-items:flex-start;gap:8rpx;margin:30rpx 0 34rpx}.progress-item{display:flex;flex-direction:column;align-items:center;font-size:22rpx;color:#94a3aa;gap:10rpx;white-space:nowrap}.progress-item text{width:42rpx;height:42rpx;background:#e1e8eb;color:#8a9da7;border-radius:50%;text-align:center;line-height:42rpx;font-size:22rpx}.progress-item.active{color:#17778b}.progress-item.active text{background:#17778b;color:white}.progress-line{flex:1;height:2rpx;background:#dfe7eb;margin-top:21rpx}.picker-arrow{float:right;color:#94a3aa}.doctor-list{display:flex;gap:14rpx;flex-wrap:wrap;margin:26rpx 0}.doctor-chip{padding:12rpx 20rpx;border:1rpx solid #d9e3e8;border-radius:100rpx;color:#637c88;font-size:24rpx}.doctor-chip.chosen{background:#e2f0f3;border-color:#17778b;color:#17778b}.slot{margin-top:18rpx;padding:24rpx;border:1rpx solid #e1e8eb;background:white;text-align:left;font-weight:400;border-radius:18rpx}.slot.chosen-slot{border:2rpx solid #17778b;background:#eaf3f5}.slot-top{display:flex;justify-content:space-between;align-items:center;font-size:29rpx;font-weight:600}.slot-tag{font-size:22rpx;font-weight:400;color:#17778b}.slot-time{font-size:25rpx;color:#748791;margin-top:10rpx}.slot-empty{padding:38rpx 0;text-align:center}.summary-person{display:flex;align-items:center;gap:16rpx;margin-top:26rpx}.allergy-item{background:#fff4df;color:#8b672b;font-size:25rpx;padding:18rpx;border-radius:12rpx;margin-top:14rpx}
.project-list{display:block}.project-list.collapsed{max-height:320rpx;overflow:hidden}

.result-context{font-size:25rpx;color:#526a77;margin:20rpx 0}.result-context>view{font-size:23rpx;margin-top:4rpx}.slot-time{color:#566e7b}

.intent-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:20rpx}.intent-card{margin:0;padding:24rpx 18rpx;white-space:normal;text-align:left;font-weight:400;background:#f7fafb;border:2rpx solid #dce7eb;border-radius:18rpx;line-height:1.5}.intent-card.selected-intent{background:#eaf5f7;border-color:#17778b}.intent-title{font-size:29rpx;font-weight:600;color:#234450}.intent-description{margin-top:10rpx;font-size:23rpx;color:#617b85}

.doctor-list{display:grid;grid-template-columns:1fr}.doctor-chip{border-radius:18rpx;padding:24rpx}.doctor-name{font-size:29rpx;font-weight:600}.doctor-name text{font-size:23rpx;margin-left:20rpx;font-weight:400}.doctor-direction,.doctor-bio{font-size:24rpx;margin-top:10rpx;white-space:normal}.doctor-bio{line-height:1.7;color:#536f7b}.fee-summary{display:flex;justify-content:space-between;margin-top:26rpx;padding:22rpx;background:#eef6f8;font-size:30rpx;font-weight:600}
