<view class="page personal-page">
 <view class="personal-brand">安德鲁牙科 <text>您的口腔就诊服务</text></view>
 <view class="profile-card"><view class="profile-main"><view class="avatar"><image src="/assets/user-active.png"/></view><view class="entry-body"><view class="profile-name">{{patient ? patient.full_name : (authenticated ? '微信已登录' : '欢迎来到安德鲁')}}</view><view class="profile-caption">{{bound ? '当前账号已关联本人档案' : (authenticated ? '尚未关联就诊档案' : '登录后使用预约及本人服务')}}</view></view><button class="account-button" bindtap="account">账号 ›</button></view>
 <view class="profile-status"><view><view class="status-label">本人就诊档案</view><view class="status-value">{{bound ? '已关联' : (authenticated ? '待关联' : '未登录')}}</view></view><button wx:if="{{!authenticated}}" type="primary" bindtap="login" disabled="{{busy}}">微信登录</button><button wx:elif="{{!bound}}" type="primary" bindtap="binding" disabled="{{busy}}">填写就诊资料</button><button wx:else type="primary" bindtap="profile" disabled="{{busy}}">查看档案</button></view>
 <view wx:if="{{authenticated && !bound && !busy}}" class="profile-help">首次就诊填写本人资料即可预约，患者编号由系统生成；已有档案可申请安全关联。</view></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{busy}}" class="loading">正在读取本人服务…</view>
 <view class="card appointments-card"><view class="section-head"><view class="card-title">我的预约</view><button class="link" bindtap="records">全部预约 ›</button></view><view class="record-shortcuts"><button data-filter="SCHEDULED" bindtap="records"><image src="/assets/calendar-active.png"/><text>待就诊</text></button><button data-filter="DONE" bindtap="records"><image src="/assets/records-active.png"/><text>已完成</text></button><button data-filter="CANCELLED" bindtap="records"><image src="/assets/records-active.png"/><text>已取消</text></button><button bindtap="booking"><image src="/assets/clinic-active.png"/><text>去预约</text></button></view></view>
 <view class="section-head service-heading"><view class="section-title">就诊服务</view></view>
 <view class="card personal-services"><button class="entry service-entry" bindtap="profile"><view class="icon-box"><image class="nav-icon" src="/assets/folder-active.png"/></view><view class="entry-body"><view>本人就诊档案</view><view class="description">个人资料与过敏核实记录</view></view><text class="chevron">›</text></button><button class="entry service-entry" bindtap="binding"><view class="icon-box"><image class="nav-icon" src="/assets/link-active.png"/></view><view class="entry-body"><view>就诊资料管理</view><view class="description">{{bound ? '查看当前账号的关联结果' : '首次登记或关联已有档案'}}</view></view><text class="chevron">›</text></button><button class="entry service-entry" bindtap="account"><view class="icon-box"><image class="nav-icon" src="/assets/user-active.png"/></view><view class="entry-body"><view>登录与账号</view><view class="description">微信登录状态与安全退出</view></view><text class="chevron">›</text></button></view>
 <button class="card payment-notice entry" bindtap="fees"><view class="entry-body"><view class="card-title">我的费用</view><view class="description">待缴费用、演示缴费与退款记录</view><view class="hint">演示支付，不扣真实款</view></view><text class="chevron">›</text></button>
 <button class="secondary small" bindtap="load" disabled="{{busy}}">刷新服务状态</button><view class="footnote">当前仅提供本人就诊服务。资料更正、解绑或换号请联系门店前台。</view>
</view>