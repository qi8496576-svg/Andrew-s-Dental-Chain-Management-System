<view class="page home-page">
 <view class="brand-row"><view class="brand-mark">A<view class="brand-dot"></view></view><view><view class="brand-name">安德鲁牙科</view><view class="eyebrow">ANDREW’S DENTAL</view></view><view class="brand-caption">连锁口腔 · 本人服务</view></view>
 <view class="hero"><view class="hero-kicker">CARE FOR YOUR SMILE</view><view class="hero-title"><view>让每一次微笑，</view><view>都有安心的照护。</view></view><view class="hero-copy">选门店 · 选医生 · 约好时间</view><button class="hero-button" bindtap="booking">预约口腔就诊 <text>→</text></button><view class="hero-orbit orbit-one"></view><view class="hero-orbit orbit-two"></view><view class="hero-spark">✦</view></view>
 <view class="identity-strip" bindtap="{{authenticated ? (bound ? 'mine' : 'binding') : 'login'}}"><view class="identity-dot"></view><view class="identity-copy">{{!authenticated ? '登录后开启您的专属就诊服务' : (bound ? '本人档案已绑定，安心预约就诊' : '微信已登录，填写本人资料即可预约')}}</view><text class="chevron">›</text></view>
 <view class="section-head"><view class="section-title">就诊服务</view><text class="muted">从预约到就诊，清晰有序</text></view>
 <view class="service-grid"><view class="service-tile" bindtap="booking"><image class="tile-icon" src="/assets/calendar-active.png"/><view class="tile-title">预约就诊</view><view class="tile-copy">查看医生与可约时段</view></view><view class="service-tile" bindtap="records"><image class="tile-icon" src="/assets/records-active.png"/><view class="tile-title">我的预约</view><view class="tile-copy">查看安排与取消预约</view></view><view class="service-tile" bindtap="profile"><image class="tile-icon" src="/assets/folder-active.png"/><view class="tile-title">就诊档案</view><view class="tile-copy">本人资料与过敏记录</view></view><view class="service-tile" bindtap="binding"><image class="tile-icon" src="/assets/link-active.png"/><view class="tile-title">就诊人信息</view><view class="tile-copy">首次登记或关联已有档案</view></view></view>
 <view class="section"><view class="section-head"><view class="section-title">选择就诊门店</view><button class="link" bindtap="booking">去预约 ›</button></view><view wx:if="{{busy}}" class="loading">正在读取门店…</view><view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重新加载</button></view><view wx:for="{{clinics}}" wx:key="id" class="card clinic-card" data-clinic="{{item.id}}" bindtap="booking"><view class="icon-box"><image class="nav-icon" src="/assets/clinic-active.png"/></view><view class="entry-body"><view class="card-title">{{item.label}}</view><view class="description">选择项目与日期，查看实际可约安排</view></view><text class="chevron">›</text></view><view wx:if="{{!busy && !authenticated}}" class="card soft"><view class="card-title">从您熟悉的门店开始</view><view class="description">微信登录后查看门店目录，首次填写本人资料即可预约。</view><button class="link" bindtap="login">微信登录 ›</button></view><view wx:if="{{!busy && authenticated && !clinics.length && !error}}" class="empty">暂无可选门店，请联系诊所。</view></view>
 <view class="care-note"><view class="care-line"></view><view><view class="card-title">就诊前的小提醒</view><view class="description">请核对本人资料及全部已知过敏。信息有变化时，请先联系前台核实。</view></view></view><view class="footnote">ANDREW’S DENTAL · 用心照护每一份信任</view>
</view>


