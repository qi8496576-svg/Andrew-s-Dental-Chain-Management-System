<view class="page"><view class="eyebrow">YOUR VISITS, IN ONE PLACE</view><view class="row"><view class="title">我的预约</view><button class="small secondary" bindtap="refresh" disabled="{{busy || unknown}}">刷新</button></view><view class="subtitle">每一次就诊安排，都有清晰的记录。</view><view class="tabs"><view class="tab {{filter === 'ALL' ? 'active' : ''}}" data-filter="ALL" bindtap="filter">全部</view><view class="tab {{filter === 'SCHEDULED' ? 'active' : ''}}" data-filter="SCHEDULED" bindtap="filter">待就诊</view><view class="tab {{filter === 'IN_PROGRESS' ? 'active' : ''}}" data-filter="IN_PROGRESS" bindtap="filter">诊疗中</view><view class="tab {{filter === 'COMPLETED' ? 'active' : ''}}" data-filter="COMPLETED" bindtap="filter">已完成治疗</view><view class="tab {{filter === 'INVOICED' ? 'active' : ''}}" data-filter="INVOICED" bindtap="filter">已生成费用凭据</view><view class="tab {{filter === 'CANCELLED' ? 'active' : ''}}" data-filter="CANCELLED" bindtap="filter">已取消</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{busy}}" class="loading">正在读取本人预约…</view><view wx:if="{{!busy && !appointments.length && !error}}" class="empty"><view class="empty-symbol">＋</view><view class="empty-title">还没有就诊安排</view><view class="description">选好门店和时间，开始您的口腔照护。</view><button type="primary" bindtap="booking">预约口腔就诊</button></view><view wx:if="{{error && !appointments.length}}" class="card"><button class="secondary" bindtap="binding">查看本人档案绑定</button><button class="link" bindtap="login">微信登录</button></view>
<block wx:for="{{appointments}}" wx:key="appointment_id"><view wx:if="{{filter === 'ALL' || filter === item.status || (filter === 'DONE' && (item.status === 'COMPLETED' || item.status === 'INVOICED'))}}" class="card appointment-card"><view class="row"><view class="card-title">{{item.time}}</view><text class="badge {{item.status === 'CANCELLED' ? 'gray' : item.status === 'SCHEDULED' ? 'warn' : ''}}">{{item.label}}</text></view><view class="description">{{item.clinicLabel}}</view><view class="appointment-meta">{{item.doctorLabel}}</view><view class="mono">预约编号 {{item.appointment_id}}</view><view wx:if="{{item.status === 'IN_PROGRESS'}}" class="appointment-tip">已由前台确认到诊，请按诊所安排就诊。</view><view wx:if="{{item.status === 'INVOICED'}}" class="appointment-tip">已生成费用凭据；此状态不表示已付款。</view><view wx:if="{{item.status === 'CANCELLED'}}" class="appointment-tip">{{item.cancellation_kind === 'NO_SHOW' ? '经前台核实登记未到诊' : item.cancellation_kind === 'CLINIC_CANCEL' || item.cancellation_kind === 'CLINIC_RESCHEDULE' ? '诊所停诊安排，请联系前台' : '预约已取消，历史记录保留'}}</view><view class="appointment-actions" wx:if="{{item.status === 'SCHEDULED'}}"><text class="hint">{{item.canCancel ? '开始前可申请取消' : '已到预约时间，请联系前台'}}</text><button class="small secondary" data-id="{{item.appointment_id}}" bindtap="select" disabled="{{busy || unknown || !item.canCancel}}">取消预约</button></view></view></block>
<view wx:if="{{appointments.length && !visibleCount}}" class="empty"><view class="empty-title">暂无该状态的预约</view><view class="description">可切换其他状态查看。{{next ? '还有未加载记录，请继续加载。' : ''}}</view></view><button wx:if="{{next}}" class="secondary" bindtap="more" disabled="{{busy || unknown}}">加载更多本人预约</button>
<view wx:if="{{selected || unknown}}" class="card cancel-panel"><view class="card-title">确认取消这次预约？</view><view class="description">取消后不可恢复，若仍需就诊请重新预约。仅正常班次且预约开始前允许患者自助取消。</view><view class="mono">预约编号 {{selected}}</view><view class="field"><text class="field-label">取消原因</text><input class="input" placeholder="请简要填写取消原因" value="{{reason}}" bindinput="reason" maxlength="255" disabled="{{busy || unknown}}"/></view><view class="spacer"></view><button class="danger" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{unknown ? '重新确认办理结果' : '确认取消本人预约'}}</button><button wx:if="{{!unknown}}" class="link" bindtap="dismiss" disabled="{{busy}}">保留这次预约</button><button wx:if="{{unknown}}" class="link" bindtap="query" disabled="{{busy}}">查询原取消结果</button></view><view class="footnote">诊疗中、已完成及已生成费用凭据预约不可取消。停诊改约或时隙结束后的处理，请联系诊所前台核实。</view></view>
