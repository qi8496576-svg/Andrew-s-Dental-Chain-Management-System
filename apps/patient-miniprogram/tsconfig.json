{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "rootDir": "miniprogram",
    "outDir": "dist/miniprogram",
    "types": ["miniprogram-api-typings"],
    "sourceMap": false
  },
  "include": ["miniprogram/**/*.ts"]
}
