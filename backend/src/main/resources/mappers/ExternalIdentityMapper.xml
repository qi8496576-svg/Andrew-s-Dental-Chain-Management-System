<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.ExternalIdentityMapper">
  <resultMap id="row" type="com.adc.infrastructure.technical.ExternalIdentityRecord">
    <constructor>
      <idArg column="external_identity_id" javaType="java.lang.Long"/>
      <arg column="subject_id" javaType="java.lang.String"/>
      <arg column="provider" javaType="java.lang.String"/>
      <arg column="appid" javaType="[B"/>
      <arg column="openid" javaType="[B"/>
      <arg column="created_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `external_identity_id`, `subject_id`, `provider`, `appid`, `openid`, `created_at` FROM adc_identity.`ExternalIdentity` WHERE `external_identity_id` = #{external_identity_id}
  </select>
</mapper>
