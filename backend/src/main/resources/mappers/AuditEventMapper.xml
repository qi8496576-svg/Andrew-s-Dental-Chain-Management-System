<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.AuditEventMapper">
  <resultMap id="row" type="com.adc.infrastructure.technical.AuditEventRecord">
    <constructor>
      <idArg column="audit_id" javaType="java.lang.Long"/>
      <arg column="subject_id" javaType="java.lang.String"/>
      <arg column="actor_kind" javaType="java.lang.String"/>
      <arg column="action" javaType="java.lang.String"/>
      <arg column="object_kind" javaType="java.lang.String"/>
      <arg column="object_id" javaType="java.lang.String"/>
      <arg column="clinic_scope" javaType="java.lang.String"/>
      <arg column="occurred_at" javaType="java.time.Instant"/>
      <arg column="request_id" javaType="java.lang.String"/>
      <arg column="result" javaType="java.lang.String"/>
      <arg column="reason" javaType="java.lang.String"/>
      <arg column="change_summary" javaType="java.lang.String"/>
      <arg column="verification_reference" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `audit_id`, `subject_id`, `actor_kind`, `action`, `object_kind`, `object_id`, `clinic_scope`, `occurred_at`, `request_id`, `result`, `reason`, `change_summary`, `verification_reference` FROM adc_audit.`AuditEvent` WHERE `audit_id` = #{audit_id}
  </select>
</mapper>
