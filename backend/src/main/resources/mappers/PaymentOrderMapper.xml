<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.PaymentOrderMapper">
  <resultMap id="row" type="com.adc.domain.model.PaymentOrder">
    <constructor>
      <idArg column="payment_id" javaType="java.lang.Long"/>
      <arg column="bill_id" javaType="java.lang.Long"/>
      <arg column="amount_fen" javaType="java.lang.Long"/>
      <arg column="mode" javaType="java.lang.String"/>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="paid_at" javaType="java.time.LocalDateTime"/>
      <arg column="created_at" javaType="java.time.LocalDateTime"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">SELECT `payment_id`,`bill_id`,`amount_fen`,`mode`,`status`,`paid_at`,`created_at` FROM adc_business.`PaymentOrder` WHERE `payment_id` = #{payment_id}</select>
</mapper>
