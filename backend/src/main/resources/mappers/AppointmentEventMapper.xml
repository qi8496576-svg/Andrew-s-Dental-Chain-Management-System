      <arg column="to_status" javaType="java.lang.String"/>
      <arg column="occurred_at" javaType="java.time.Instant"/>
      <arg column="actor_role" javaType="java.lang.String"/>
      <arg column="actor_reference" javaType="java.lang.String"/>
      <arg column="reason" javaType="java.lang.String"/>
