<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.AppointmentEventMapper">
  <resultMap id="row" type="com.adc.domain.model.AppointmentEvent">
    <constructor>
      <idArg column="appointment_event_id" javaType="java.lang.Long"/>
      <arg column="appointment_id" javaType="java.lang.Long"/>
      <arg column="event_type" javaType="java.lang.String"/>
