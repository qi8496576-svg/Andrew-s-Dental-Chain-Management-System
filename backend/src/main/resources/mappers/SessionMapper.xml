<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.SessionMapper">
  <resultMap id="row" type="com.adc.infrastructure.technical.SessionRecord">
    <constructor>
      <idArg column="session_id" javaType="java.lang.String"/>
      <arg column="subject_id" javaType="java.lang.String"/>
      <arg column="token_hash" javaType="[B"/>
      <arg column="client_type" javaType="java.lang.String"/>
      <arg column="csrf_secret_hash" javaType="[B"/>
      <arg column="created_at" javaType="java.time.Instant"/>
      <arg column="last_activity_at" javaType="java.time.Instant"/>
      <arg column="absolute_expires_at" javaType="java.time.Instant"/>
      <arg column="revoked_at" javaType="java.time.Instant"/>
      <arg column="revoked_reason" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `session_id`, `subject_id`, `token_hash`, `client_type`, `csrf_secret_hash`, `created_at`, `last_activity_at`, `absolute_expires_at`, `revoked_at`, `revoked_reason` FROM adc_identity.`Session` WHERE `session_id` = #{session_id}
  </select>
</mapper>
