<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.TreatmentMapper">
  <resultMap id="row" type="com.adc.domain.model.Treatment">
    <constructor>
      <idArg column="treatment_id" javaType="java.lang.Long"/>
      <arg column="treatment_code" javaType="java.lang.String"/>
      <arg column="treatment_name" javaType="java.lang.String"/>
      <arg column="description" javaType="java.lang.String"/>
      <arg column="default_unit_price" javaType="java.math.BigDecimal"/>
      <arg column="is_active" javaType="java.lang.Boolean"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `treatment_id`, `treatment_code`, `treatment_name`, `description`, `default_unit_price`, `is_active` FROM adc_business.`Treatment` WHERE `treatment_id` = #{treatment_id}
  </select>
</mapper>
