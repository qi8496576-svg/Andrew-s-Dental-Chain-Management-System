<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.ClinicMapper">
  <resultMap id="row" type="com.adc.domain.model.Clinic">
    <constructor>
      <idArg column="clinic_id" javaType="java.lang.Long"/>
      <arg column="clinic_code" javaType="java.lang.String"/>
      <arg column="postal_address" javaType="java.lang.String"/>
      <arg column="manager_name" javaType="java.lang.String"/>
      <arg column="phone" javaType="java.lang.String"/>
      <arg column="email" javaType="java.lang.String"/>
      <arg column="office_area_sqm" javaType="java.math.BigDecimal"/>
      <arg column="is_active" javaType="java.lang.Boolean"/>
      <arg column="created_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `clinic_id`, `clinic_code`, `postal_address`, `manager_name`, `phone`, `email`, `office_area_sqm`, `is_active`, `created_at` FROM adc_business.`Clinic` WHERE `clinic_id` = #{clinic_id}
  </select>
</mapper>
