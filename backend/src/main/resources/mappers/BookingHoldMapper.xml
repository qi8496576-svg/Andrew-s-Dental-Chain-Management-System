      <arg column="slot_minutes" javaType="java.lang.Short"/>
      <arg column="requested_treatment_ids" javaType="java.lang.String"/>
      <arg column="confirmation_digest" javaType="[B"/>
      <arg column="expires_at" javaType="java.time.LocalDateTime"/>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="appointment_id" javaType="java.lang.Long"/>
