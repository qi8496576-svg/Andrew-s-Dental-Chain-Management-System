<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.LoginThrottleMapper">
  <resultMap id="row" type="com.adc.infrastructure.technical.LoginThrottleRecord">
    <constructor>
      <idArg column="throttle_key" javaType="[B"/>
      <arg column="subject_id" javaType="java.lang.String"/>
      <arg column="consecutive_failures" javaType="java.lang.Integer"/>
      <arg column="blocked_until" javaType="java.time.Instant"/>
      <arg column="last_failure_at" javaType="java.time.Instant"/>
      <arg column="updated_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `throttle_key`, `subject_id`, `consecutive_failures`, `blocked_until`, `last_failure_at`, `updated_at` FROM adc_identity.`LoginThrottle` WHERE `throttle_key` = #{throttle_key}
  </select>
</mapper>
