<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.QualificationMapper">
  <resultMap id="row" type="com.adc.domain.model.Qualification">
    <constructor>
      <idArg column="qualification_id" javaType="java.lang.Long"/>
      <arg column="qualification_name" javaType="java.lang.String"/>
      <arg column="description" javaType="java.lang.String"/>
      <arg column="is_active" javaType="java.lang.Boolean"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `qualification_id`, `qualification_name`, `description`, `is_active` FROM adc_business.`Qualification` WHERE `qualification_id` = #{qualification_id}
  </select>
</mapper>
