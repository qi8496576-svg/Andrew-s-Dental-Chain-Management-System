<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.AppliedTreatmentMapper">
  <resultMap id="row" type="com.adc.domain.model.AppliedTreatment">
    <constructor>
      <idArg column="applied_treatment_id" javaType="java.lang.Long"/>
      <arg column="appointment_id" javaType="java.lang.Long"/>
      <arg column="treatment_id" javaType="java.lang.Long"/>
      <arg column="dentist_id" javaType="java.lang.Long"/>
      <arg column="standard_units" javaType="java.math.BigDecimal"/>
      <arg column="unit_price" javaType="java.math.BigDecimal"/>
      <arg column="subtotal" javaType="java.math.BigDecimal"/>
      <arg column="performed_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `applied_treatment_id`, `appointment_id`, `treatment_id`, `dentist_id`, `standard_units`, `unit_price`, `subtotal`, `performed_at` FROM adc_business.`AppliedTreatment` WHERE `applied_treatment_id` = #{applied_treatment_id}
  </select>
</mapper>
