<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.PatientMapper">
  <resultMap id="row" type="com.adc.domain.model.Patient">
    <constructor>
      <idArg column="patient_id" javaType="java.lang.Long"/>
      <arg column="patient_number" javaType="java.lang.String"/>
      <arg column="full_name" javaType="java.lang.String"/>
      <arg column="date_of_birth" javaType="java.time.LocalDate"/>
      <arg column="billing_address" javaType="java.lang.String"/>
      <arg column="phone" javaType="java.lang.String"/>
      <arg column="email" javaType="java.lang.String"/>
      <arg column="emergency_contact_name" javaType="java.lang.String"/>
      <arg column="emergency_contact_phone" javaType="java.lang.String"/>
      <arg column="created_at" javaType="java.time.Instant"/>
      <arg column="updated_at" javaType="java.time.Instant"/>
      <arg column="allergy_review_status" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `patient_id`, `patient_number`, `full_name`, `date_of_birth`, `billing_address`, `phone`, `email`, `emergency_contact_name`, `emergency_contact_phone`, `created_at`, `updated_at`, `allergy_review_status` FROM adc_business.`Patient` WHERE `patient_id` = #{patient_id}
  </select>
</mapper>
