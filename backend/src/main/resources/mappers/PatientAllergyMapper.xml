<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.adc.infrastructure.persistence.PatientAllergyMapper">
  <resultMap id="row" type="com.adc.domain.model.PatientAllergy">
    <constructor>
      <idArg column="patient_id" javaType="java.lang.Long"/>
      <idArg column="allergy_id" javaType="java.lang.Long"/>
      <arg column="noted_at" javaType="java.time.Instant"/>
      <arg column="severity_note" javaType="java.lang.String"/>
      <arg column="clinical_note" javaType="java.lang.String"/>
      <arg column="is_retracted" javaType="java.lang.Boolean"/>
      <arg column="audit_history" javaType="java.lang.String"/>
      <arg column="updated_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>
  <select id="findById" resultMap="row">
    SELECT `patient_id`, `allergy_id`, `noted_at`, `severity_note`, `clinical_note`, `is_retracted`, `audit_history`, `updated_at` FROM adc_business.`PatientAllergy` WHERE `patient_id` = #{patient_id} AND `allergy_id` = #{allergy_id}
  </select>
</mapper>
