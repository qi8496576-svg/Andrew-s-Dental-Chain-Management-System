title 图 C1 实体类图
class "患者" as e0 <<entity>> {
  姓名
  出生日期
  账单地址
  电话号码
  电子邮箱
  紧急联系人姓名
  紧急联系人电话
  过敏资料确认情况
  +登记资料(资料)
  +登记过敏症(过敏症,程度)
  +更正过敏资料(过敏症,变更,核实人,原因)
  +确认过敏资料()
}
class "就诊" as e1 <<entity>> {
  预约时间
  状态 status
  问题或特殊需求
  到诊时点
  完成时点
  取消时点
  取消分类
  取消原因
  +建立预约(患者,班次,时隙,期望治疗集合,请求标识)
  +确认到诊(核实人,请求标识)
  +核对已到诊()
  +登记取消(分类,原因,请求标识)
  +记录问题与特殊需求(内容)
  +增加施用治疗(项目,单位数,实施时间)
  +完成就诊(时点,请求标识)
  +确认可结算()
  +组织开票明细(结算单)
  +登记结算(结算单)
  +统计取消情况(范围,期间)
}
class "结算单" as e2 <<entity>> {
  单号
  结算时点
  总价
  +建立(就诊)
  +增加明细(施用治疗)
  +计算总价()
  +汇总季度收入(牙医,季度)
}
class "季度绩效" as e3 <<entity>> {
  季度
  收入
  医疗用品成本
  运营费用
  净利润
  激励额
  计算版本
  发布状态
  +准备核算依据(季度,资料,人员范围)
  +建立版本(牙医,季度,输入摘要)
  +计算净利润()
  +计算激励额()
  +标记核算状态(状态,原因)
  +发布结果(复核人)
  +汇总已发布绩效(季度)
}
class "过敏症" as e4 <<entity>> {
  名称
  描述
  +登记目录项(名称,描述)
  +确认可选()
}
class "施用治疗" as e5 <<entity>> {
  标准单位数
  标准单位价格
  小计
  实施时间
  责任牙医
  +建立(项目,单位数,历史单价,实施时间)
  +计算小计()
  +计入结算(结算单)
}
class "成本凭证" as e6 <<entity>> {
  类型
  金额
  发生时点
  来源凭证引用
  来源批次
  确认时点
  确认人
  +登记来源(凭证,确认资料)
  +确认完整性(季度,诊所确认)
  +汇总季度成本(牙医,季度,有效排班时长快照)
}
class "牙医" as e7 <<entity>> {
  姓名
  出生日期
  家庭住址
  电话号码
  电子邮箱
  受雇日期
  离职日期
  +登记资料(资料)
  +确认执业范围(诊所,日期)
  +筛选候选牙医(诊所,期望治疗集合,日期范围)
  +登记专业资质(资质,有效期,核验状态)
  +建立服务关系(诊所,有效期)
  +确认核算范围(季度,确认名单)
  +汇总技能结构(范围,期间)
}
class "治疗项目" as e8 <<entity>> {
  名称
  描述
  默认单价
  +登记目录项(名称,默认单价)
  +维护所需资质(资质集合)
  +确定标准单价(登记时点)
  +统计治疗标准(范围,期间)
}
class "专业资质" as e9 <<entity>> {
  名称
  描述
  +登记目录项(名称,描述)
  +确认有效()
}
class "出诊排班" as e10 <<entity>> {
  出诊日期
  开始时间
  结束时间
  接诊粒度
  班次状态
  +列出可约时隙(候选牙医集合,日期范围)
  +登记班次(牙医,诊所,日期,时段,时隙长度)
  +校验不重叠()
  +挂起班次(原因)
  +列出受影响预约()
  +统计技能时隙覆盖(范围,期间,治疗)
}
class "诊所" as e11 <<entity>> {
  执业地点
  联系人姓名
  电话号码
  电子邮箱
  办公面积
  +登记资料(资料)
  +确认可安排范围()
}
e0 "1" -- "0..*" e1 : 接受
e0 "0..*" -- "0..*" e4 : 患有
e1 "0..1" -- "0..1" e1 : 改约来源
e1 "1" -- "0..1" e2 : 生成
e1 "1" *-- "0..*" e5 : 包含
e3 "0..*" -- "1" e7 : 核算
e3 ..> e6 : 使用
e6 "0..*" -- "0..1" e1 : 归集
e6 "0..*" -- "0..1" e5 : 归集
e6 "0..*" -- "0..1" e7 : 归属
e6 "0..1" -- "0..1" e6 : 冲销
e5 "0..*" -- "1" e8 : 对应
e5 "0..*" -- "1" e7 : 责任牙医
e8 "0..*" -- "0..*" e9 : 所需资质
e7 "0..*" -- "0..*" e9 : 持有
e7 "1" -- "0..*" e10 : 出诊
e7 "0..*" -- "0..*" e11 : 可执业
e10 "0..*" -- "1" e11 : 安排
e1 "0..*" -- "1" e10 : 被预约
e1 "0..*" -- "0..*" e8 : 期望治疗
e6 "0..*" -- "1" e11 : 归集
@enduml
